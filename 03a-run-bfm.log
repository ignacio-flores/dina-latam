  2.         
.         foreach pf in "pre" "pos" {
  3.                 
.                 // Details for file replace / no-replace distinction
.                 if ("`type'" == "rep") local command ""
  4.                 if ("`type'" == "rep") local ext ""
  5.                 if ("`type'" == "norep") local command "noreplace"
  6.                 if ("`type'" == "norep") local ext "_norep"
  7. 
.                 //start from scratch 
.                 clear
  8.                 local obs_mp = wordcount("`ctry_yr_list`ext'_`pf''")
  9.                 set obs `obs_mp'
 10.                 qui gen country_year = ""
 11.                 
.                 //loop over values 
.                 forvalues n = 1 / `obs_mp' {
 12.                         local wd_`n': word `n' of `ctry_yr_list`ext'_`pf''
 13.                         qui replace country_year = "`wd_`n''" in `n'
 14.                 }
 15.                 
.                 //save results 
.                 local mpfile "output/bfm_summary/bfm`ext'_`pf'/merging_points
> .xlsx"
 16.                 qui export excel `mpfile', firstrow(variables) ///
>                         sheet("country_years") sheetreplace keepcellfmt
 17.                                 
.                 //report unobserved population 
.                 qui split country_year, parse(_) gen(v) 
 18.                 qui rename (v1 v2) (country year)
 19.                 qui gen unobs = . 
 20.                 qui drop country_year
 21.                 qui levelsof country, local(countries) clean
 22.                 foreach c in `countries' {
 23.                         qui levelsof year if country == "`c'", local(`c'_y
> ears) clean
 24.                         foreach y in ``c'_years' {
