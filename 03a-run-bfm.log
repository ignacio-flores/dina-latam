127.                                 di as text "`c' `t': tax data exists but s
> urvey does not"
128.                         }               
129.                 }       
130.                 else {  
131.                         cap confirm file `svyfile'              
132.                         if !_rc {
133.                                 di as text "`c' `t': Survey data exists, b
> ut tax data does not"
134.                         }               
135.                         else {
136.                                 di as text "`c' `t': Both survey and tax d
> ata" _continue
137.                                 di as text " do not exist for this year"
138.                         }
