 26.                         }
 27.                 }
 28.                 
.                 //save results 
.                 local mpfile "output/bfm_summary/bfm`ext'_`pf'/merging_points
> .xlsx"
 29.                 qui export excel `mpfile', firstrow(variables) ///
>                         sheet("unobserved") sheetreplace keepcellfmt
 30.                         
.         }
