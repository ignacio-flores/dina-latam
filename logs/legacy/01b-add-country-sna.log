.         preserve
.                 foreach x in "" "_2stage" { 
  2.                         foreach z in "pos" "pre" {      
  3.                                 //bring list of overlaps 
.                                 cap import excel ///
>                                         "output/bfm_summary/bfm`ext'_`z'/merg
> ing_points.xlsx", ///
>                                         sheet("country_years`x'") firstrow cl
> ear                
  4.                                 if !_rc {
  5.                                         //save if it exists 
.                                         quietly ds 
  6.                                         quietly split `r(varlist)', parse(
> _) gen(v)     
  7.                                         
.                                         //exceptions 
.                                         quietly drop if v1 == "CHL" & inlist(
> v2, "2000", "2003")
  8.                                         quietly drop if v1 == "ECU" & inli
> st(v2, "2011")
  9.                                         
.                                         //list years 
.                                         quietly levelsof v1, local(countries`
> x'_`z') clean
 10.                                         foreach c in `countries`x'_`z'' {
 11.                                                 if ("`c'_years" != "") loc
> al `c'_first_list ``c'_years'
 12.                                         
.                                                 quietly levelsof v2 if v1 == 
> "`c'", local(`c'_years) clean
 13.                                                 if ("``c'_first_list'" != 
> "") local `c'_years "``c'_years' ``c'_first_list'"
 14.                                                 global `c'_overlap_years `
> `c'_years'
 15.                                                 di as result "`c': ${`c'_o
> verlap_years}"
 16.                                         }
 17.                                 }
 18.                         }
 19.                 }
.         restore
.         
.         foreach c in `countries_pos' `countries_pre' `countries_2stage_pos' `
> countries_2stage_pre' {
  2.                 display as text "`c': ${`c'_years}"     
  3.                 local all_overlaps "`all_overlaps' "`c'" "
  4.         }
.         global overlap_countries " `all_overlaps' "
. }

