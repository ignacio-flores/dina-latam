. //make room for data 
. qui clear 

. local n_ctries = wordcount( `"${ctries_cei}"' )

. local n_obs = (`last_yr' - `first_yr' + 1) * `n_ctries'

. set obs `n_obs'
number of observations (_N) was 0, now 225

. qui gen country = ""

. 
. *make room for variables 
. foreach n in `dcodes' {
  2.         qui gen D`n'_cei = . 
  3. }

. foreach n in `bcodes' {
  2.         qui gen B`n'g_cei = .
  3.         if `n' == 5{
  4.                 foreach i in "NFC" "FC" "GG" "TOT"{
  5.                         qui gen `i'_B`n'g_cei = . 
  6.                 }
  7.         }
  8. }

. foreach n in 4 41 42 43 44 {
  2.         foreach var in NFC_r FC_r GG_r TOT_r ROW_r {
  3.                 qui gen `var'_D`n'_cei = . 
  4.         }
  5. }       

. foreach var in "year" "ratio_d43d44" ///
>         "ratio_d43_d4" "ratio_d44_d4" "ratio_d44_b5g" ///
>         "ratio_d75_d7" "ratio_d75_b5g" {
  2.         qui gen `var' = .
  3. }

. order country year

. 
. //loop over countries and years  
. local iter = 1 

. foreach c in $ctries_cei {
  2.         forvalues y = `first_yr' / `last_yr' {
  3.                 
.                 //fill values 
.                 qui replace country = "`c'" in `iter'
  4.                 qui replace year = `y' in `iter'
  5.                 
.                 //Fill variables 
.                 foreach n in `dcodes' {
  6.                         if !inlist("`hh_d`n'r_`c'_`y''", "", "0") {
  7.                                 qui replace D`n'_cei = `hh_d`n'r_`c'_`y'' 
> in `iter'
  8.                         } 
  9.                 }
 10.                 
.                 foreach j in `bcodes' {
 11.                         if !inlist("`hh_b`j'g_`c'_`y''", "", "0") {
 12.                                 qui replace B`j'g_cei = `hh_b`j'g_`c'_`y''
>  in `iter'
 13.                         } 
 14.                         if `j' == 5 {
 15.                                 foreach i in "NFC" "FC" "GG" "TOT" {
 16.                                         if !inlist("``i'_b`j'g_`c'_`y''", 
> "", "0") {
 17.                                                 qui replace `i'_B`j'g_cei 
> = ``i'_b`j'g_`c'_`y'' ///
>                                                         in `iter'
 18.                                         } 
 19.                                 }
 20.                         }
 21.                 }
 22.                 
.                 foreach var in "ratio_d43d44" ///
>                         "ratio_d43_d4" "ratio_d44_d4" "ratio_d44_b5g" ///
>                         "ratio_d75_d7" "ratio_d75_b5g" {
 23.                         if "``var'_`c'_`y''" != "" {
 24.                                 qui replace `var' = ``var'_`c'_`y'' in `it
> er' 
 25.                         } 
 26.                 }
 27.                 foreach n in 4 41 42 43 44 {
 28.                         foreach var in NFC_r FC_r GG_r TOT_r ROW_r { 
 29.                                 if !inlist("``var'_d`n'r_`c'_`y''", "", "0
> ") {
 30.                                         qui replace `var'_D`n'_cei = ``var
> '_d`n'r_`c'_`y'' ///
>                                                 in `iter'
 31.                                 }
 32.                         }
 33.                 }
 34.                 
.                 //add one to counter 
.                 local iter = `iter' + 1
 35.         }
 36.         
.         //prepare lines for graph
.         foreach var in $list_ratios {
 37.                 
.                 //define color 
.                 local c1 = strlower("`c'")
 38.                 local c2 "c_`c1'"
 39.                 //lines 
.                 local lines_`var' `lines_`var'' ///
>                         (connected `var' year if country == "`c'", ///
>                         lcolor($`c2') lwidth(thick) msize(tiny) msymbol(O) //
> /
>                         mfcolor($`c2') mcolor($`c2'))   
 40.                 //prepare tags 
.                 qui sum year if country == "`c'" & !missing(``var'')
 41.                 if !inlist("`c'", "CRI", "COL") local xtext_`c' = r(min)  
>       
 42.                 else local xtext_`c' = r(max)   
 43.                 qui sum ``var'' if year == `xtext_`c'' & country == "`c'" 
> ///
>                         & !missing(``var'')
 44.                 if r(mean) != . {
 45.                         local ytext = (1 - r(mean)) * 100
 46.                         if !inlist("`c'", "CRI", "COL") local text_loc_`va
> r' "`text_loc_`var'' text(`ytext' `xtext_`c'' "`c'", orientation(horizontal) 
> placement(nw) color($`c2') size(small)) "
 47.                         else local text_loc_`var' "`text_loc_`var'' text(`
> ytext' `xtext_`c'' "`c'", orientation(horizontal) placement(ne) color($`c2') 
> size(small)) "
 48.                 }       
 49.         }
 50. }

. 
. //define labels 
. local lab_pir "Matching Property Inc. (%)"

. local lab_tra "Share of remittences in transfers, in % (D75/D7)"

. 
. //define ratios of interest 
. foreach var in $list_ratios {
  2.         
.         local ylabs ""
  3.         if "`var'" == "pir" local ylabs 50(10)100 
  4.         
.         *get proportional 
.         if "`var'" == "pir" qui gen `var' = (1 - ``var'') * 100
  5.         else qui gen `var' = ``var'' * 100
  6. 
.         //graph result 
.         qui sum `var', meanonly 
  7.         local avg = r(mean)
  8.         local avg_tag = `avg' + 2
  9.         graph twoway `lines_`var'' if !missing(`var') & `var' != 0  ///
>                 , legend(off) `text_loc_`var''  ///
>                 text(`avg_tag' 1996 "AVG", color(black * 0.3)) ///
>                 ytitle("`lab_`var''") xtitle("") ///
>                 yline(`avg', lcolor(black*0.3) lwidth(thick)) ///
>                 ylabels(`ylabs', $ylab_opts_white ) ///
>                 xlabels(1995(5)2025, $xlab_opts_white ) $graph_scheme
 10.         qui graph export "output/figures/cei/`var'.pdf", replace        
 11.         qui graph export "output/figures/cei/`var'.png", replace 
 12. 
. }

. 
. *save to merge 
. tempfile savetomerge 

. qui rename country _ISO3C_ 

. qui save `savetomerge', replace 

. 
. *open SNA file 
. qui use "intermediary_data/national_accounts/UNDATA-WID-Merged.dta", clear 

. 
. *merge with SNA data
. qui merge m:1 _ISO3C_ year using `savetomerge' , nogen update replace

. 
. //ignore aggregated data for ECU (OS + MI)
. qui replace B2g_cei = . if country == "ECU" & year <= 2017

. qui replace HH_B2g_R = . if country == "ECU" & year <= 2017

. 
. //save
. qui save "intermediary_data/national_accounts/UNDATA-WID-Merged.dta" , replac
> e  

. 
end of do-file

. local dina_task_rc = _rc

. capture log close _all

. exit `dina_task_rc'

end of do-file
