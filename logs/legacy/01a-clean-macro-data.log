>                         "All countries have variables in same unit"
Gov financial balance sheets: All countries have variables in same unit
.         }

. 
.         //Clean
.         qui keep `ordr' 

. 
.         //Reshape
.         qui encode item, gen(item_n)

.         qui levelsof item_n, local(item_numbs) 

.         foreach i in `item_numbs' {
  2.                 qui levelsof item if item_n == `i', local(item_n_`i') clea
> n
  3.         }

.         qui drop item

.         destring year, replace 
year: all characters numeric; replaced as int

.         label list item_n
item_n:
           1 Currency & deposits
           2 Debt securities
           3 Equity & investment fund shares
           4 Financial derivatives & employee stock options
           5 Insurance, pension, & standardized guarantee schemes (IPSGS)
           6 Loans
           7 Monetary gold & SDRs
           8 Other accounts receivable/payable
           9 SDRs

.         qui reshape wide A_stock L_stock, i(country year) j(item_n)

.         
.         //label new variables
.         foreach i in `item_numbs' {
  2.                 qui label var A_stock`i' "Stock, Assets, `item_n_`i'', IMF
>  Data"
  3.                 qui label var L_stock`i' "Stock, Liabilities, `item_n_`i''
> , IMF Data"
  4.         }

.         
.         //Clean
.         foreach v in "A" "L" {
