. //cleaned using "code/R/01a_import-un-sna-data.R"
. 
. //0. PRELIMINARY ------------------------------------------------------------
> //
. 
. //General 
. clear all

. sysdir set PERSONAL "."

. clear programs

. 
. //preliminary
. global aux_part  ""preliminary"" 

. qui do "code/Stata/auxiliar/aux_general.do"

. 
. //Table names
. local TOT               "Table 4.1 Total Economy (S.1)"

. local RoW               "Table 4.2 Rest of the world (S.2)"

. local NFC               "Table 4.3 Non-financial Corporations (S.11)"

. local FC                "Table 4.4 Financial Corporations (S.12)"

. local GG                "Table 4.5 General Government (S.13)"

. local HH                "Table 4.6 Households (S.14)"

. local NPISH     "Table 4.7 Non-profit institutions serving households (S.15)"

. local corps     " Non-Financial and Financial Corporations (S.11 + S.12)"

. local CORPS     "Table 4.8 Combined Sectors`corps'"

. local HH_NPISH  "Table 4.9 Combined Sectors Households and NPISH (S.14 + S.15
> )"

. local all_IS    "TOT RoW NFC FC GG HH NPISH CORPS HH_NPISH"

. 
. //1. PREPARE AND CLEAN DATA -------------------------------------------------
> //
. 
. //1.1 UNDATA ----------------------------------------------------------------
> // 
. 
. local iter = 1

. tempfile tf_merge1

. foreach IS in `all_IS' {
  2.         tempvar auxi1 auxi2
  3.         qui use "input_data/sna_UNDATA/_clean/``IS''.dta", clear
  4. 
.         //Items & codes
.         qui rename sna93_item_code i_code
  5.         qui replace i_code = subinstr(i_code, ".", "",.) 
  6.         qui replace i_code = subinstr(i_code, "*", "",.) 
  7.         qui split sub_group, parse(-)
  8.         qui gen sg2 = substr(sub_group2,2,1) 
  9.         qui replace sg2 = "L" if strpos(sub_group2, "liabilities")
 10.         qui replace sg2 = "A" if strpos(sub_group2, "assets")
 11.         qui egen `auxi1' = concat(i_code sg2), punct(_)
 12. 
.         //Check for items with same code
.         qui sort iso year series `auxi1'
 13.         qui by iso year series `auxi1':  gen dup = cond(_N==1,0,_n)
 14.         qui egen `auxi2' = concat(`auxi1' dup) if dup > 0
 15.         qui replace `auxi2' = `auxi1' if dup == 0
 16.         qui replace `auxi2' = subinstr(`auxi2', "-", "",.) 
 17.         qui levelsof `auxi2', local(vars)
 18.         
.         //Get labels
.         qui egen item_lab = concat(sub_group2 item), punct(", `IS' (UN-DATA):
>  ")
 19.         qui levelsof `auxi2', local(lab_items)
 20.         foreach i in `lab_items' {
 21.                 qui levelsof item_lab if `auxi2' == "`i'", local(lab_item_
> `i') clean 
 22.         }
 23. 
.         //Reshape
.         qui keep iso year series `auxi2' value
 24.         qui reshape wide value, i(iso year series) j(`auxi2') string
 25.         qui rename value* `IS'_*
 26.         foreach i in `lab_items' {
 27.                 qui label var `IS'_`i' "`lab_item_`i''"
 28.         }
 29.         
.         //Save and merge
.         if (`iter' == 0) {
 30.                 qui mer 1:m iso year series using "`tf_merge1'", nogenerat
> e 
 31.         }
 32.         local iter = 0
 33.         qui save `tf_merge1', replace 
 34. }

. qui sort iso series year

. qui kountry iso, from(iso2c) to(iso3c) geo(undet)
iso2ciso3c_ISO3C_GEO
. 
. //Net balance of primary incomes for various sectors
. foreach IS in "FC" "NFC" "TOT" "CORPS" {
  2.         local s1 "1"
  3.         local s2 ""
  4.         if ("`IS'" == "TOT") {
  5.                 local s1 "U"
  6.                 local s2 "U"
  7.         }
  8.         qui gen `IS'_B5n_`s1' = `IS'_B5g_`s1' - `IS'_K1_`s2'
  9. }

. 
. //Keep only LATAM now   
. qui keep if inlist(GEO, "Caribbean", "South America", "Central America")

. qui egen ctry_srs = concat(iso series)

. qui encode ctry_srs, gen(ctry_srs_n)

. qui sort iso series year

. qui xtset ctry_srs_n year 

. 
. //Fill missing values and special cases [NEW CODE]
. foreach cod in "D4" "B2g" "B5g" "D5" {
  2.         foreach x in "U" "R" {
  3.                 cap qui replace HH_`cod'_`x' ///
>                         = HH_NPISH_`cod'_`x' ///
>                         if missing(HH_`cod'_`x') & ///
>                         !missing(HH_NPISH_`cod'_`x')
  4.                 local x "1"     
  5.                 cap qui replace CORPS_`cod'_`x' ///
>                         = NFC_`cod'_`x' + FC_`cod'_`x' ///
>                         if missing(CORPS_`cod'_`x') & ///
>                         !missing(NFC_`cod'_`x', FC_`cod'_`x')
  6.         }
  7. }

. 
. //Save
. tempfile tf_main 

. qui save `tf_main', replace 

