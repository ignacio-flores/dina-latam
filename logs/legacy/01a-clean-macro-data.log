. 
. //define varlist
. global widvars mnninc mgdpro mnnfin mptfrr mptfrp inyixx npopul ///
>         mccshn mccmhn mcfcco mconfc mptfhr mgsmhn mgsrhn mgmxhn mprgco agninc

. clear

. 
