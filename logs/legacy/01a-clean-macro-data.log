  3.                 label var GG_equity_`v' " Gen. Gov.: Equity & investment f
> und shares (`v')"
  4.         }

.         tempvar aux2 

.         qui egen `aux2' = rowtotal (*stock*)

.         qui drop if `aux2' == 0 

. 
.         //Display available info 
