> m(`v'_a)
303.                                                 }
304.                                                         
.                                                 //graph as incidence of scali
> ng         
.                                                 graph twoway (function y=x, r
> ange(0 100) ///
>                                                         lcolor(black)) `il_`u
> '_`c'_`y'' ///
>                                                         `totinc_l', /*title("
> `c' - `y'")*/ ///
>                                                         ytitle("Cumulative in
> come share") ///
>                                                         xtitle("Percentile") 
> ///
>                                                         xlabel(0(10)100 , $xl
> ab_opts) ///
>                                                         ylabel(0(20)100, $yla
> b_opts) ///
>                                                         $graph_scheme /*legen
> d(`leg_i3_`u'_`c'_`y'') ///
>                                                         legend(ring(1) pos(3)
>  col(1)) */ ///
>                                                         legend(off) ysize(5.5
> ) xsize(5.5) ///
>                                                         aspectratio(1) 
305.                                                 qui graph export ///
>                                                         "output/figures/uprof
> its/incidence-scal/`c'`y'_`u'.pdf", replace
306.                                         restore 
307.                                 }
308.                         
.                                 *save 
.                                 qui save "`survey'", replace
309.                                 
.                                 //report scaled variables 
.                                 *display as text "`c' `y' scaled variables: "
>  _continue
.                                 global checkvars ///
>                                         "pre_wag pre_ben pre_cap pre_imp pre_
> mix pre_mir"
310.                                 if ("`scal_list_`c'_`y''" == " $checkvars"
> ) ///
>                                         local scal_list_`c'_`y' " all"
311.                                 *display as result "`scal_list_`c'_`y''"
.                                 
.                         }
312.                         else {
313.                                 di as text "skipped, " _continue 
314.                                 di as error "`misvar_`c'_`y'' " _continue
315.                                 di as text "empty or missing"
316.                         }       
317.                 }
318.                 *report if not found
.                 else {
319.                         di as text "skipped, `survey' not found"
320.                 }
321.         }
322. }
