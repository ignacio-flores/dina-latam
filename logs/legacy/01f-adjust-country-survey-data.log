.         if ("`c'"=="CRI") {     
 44.                 forvalues year = 2010/2018 { 
 45.                         
.                         di as result "`year'"
 46. 
.                         qui cap use "intermediary_data/microdata/raw/CRI/CRI_
> `year'_raw.dta", clear     
 47.                         
.                                 qui merge 1:1 id_hogar id_pers using ///
>                                         "input_data/surveys_CEPAL/CRI/BYN/CRI
> _`year'_byn.dta", nogen
 48.                                 
.                                 * Compute taxes paid on primary and secondary
>  salaries
.                                 foreach t in tax1 tax2 tax taxm ind_pre_wag_g
> ross ///
>                                         ind_pre_fwag_gross pre_wag_svy_gross 
> ///
>                                         pre_fwag_svy_gross {
 49.                                         qui cap drop `t'
 50.                                 }
 51.                                 qui gen tax1 = 0
 52.                                 qui gen tax2 = 0
 53.                                 qui replace tax1 = spmb - spmn if spmb!=. 
> | spmn!=.
 54.                                 qui replace tax2 = ssmb - ssmn if ssmb!=. 
> | ssmn!=.
 55.                                 qui gen tax = tax1 + tax2
 56.                                 qui gen taxm = tax/12
 57.                                 
.                                 * Add difference to net wages to make them gr
> oss
.                                 qui gen ind_pre_wag_gross = ind_pre_wag + tax
 58.                                 qui gen ind_pre_fwag_gross = ind_pre_fwag 
> + tax
 59.                                 qui gen pre_wag_svy_gross = pre_wag_svy + 
> taxm
 60.                                 qui gen pre_fwag_svy_gross = pre_fwag_svy 
> + taxm
 61.                                 
.                                 qui save ///
>                                         "intermediary_data/microdata/raw/CRI/
> CRI_`year'_raw.dta", replace       
 62.                 }
 63.         }
 64. }
