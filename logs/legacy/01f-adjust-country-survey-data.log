> d
.                                 qui drop if `raw_weight' == 0
 19.                                 qui egen weight2 = mean(`raw_weight'), by(
> `id')
 20.                                 qui cap assert weight2 == `raw_weight'
 21.                                 
.                                 //Write definitive weights 
.                                 qui replace `raw_weight' = weight2
 22.                                 qui drop weight2
 23.                                 qui drop if missing(`raw_weight') | `raw_w
> eight' < 1
 24.                                 
.                                 //sum weights 
.                                 qui sum `raw_weight'
 25.                                 local poptot = r(sum)
 26.                                 di as result "ARG `year' adj factor: " ///
