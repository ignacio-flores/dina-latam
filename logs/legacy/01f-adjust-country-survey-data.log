 27.                         
.                                 
.                                 if ("`poptot'" != "`totalpop`year''") {
 28.                                         qui gen r_fep = 100/((`poptot'/`to
> talpop`year'')*100)
 29.                                         qui cap drop n_fep 
 30.                                         qui gen n_fep = `raw_weight' * r_f
> ep            
 31.                                         qui drop r_fep
 32.                                 } 
 33.                         }
 34.                         
.                         qui cap assert _N == 0
 35.                         
