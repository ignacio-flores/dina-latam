. 
. *------------------------------------------------------------------------
. *PART I.I Country adjustments
. *------------------------------------------------------------------------
.                         
. * Brazil
. qui do "code/Stata/BRA/svy_adj_BRA.do"

.                         
. *-----------------------------------------------------------------------
. *PART II: Equal-split incomes and annualization
. *-----------------------------------------------------------------------
. 
. foreach c in `countries' {  
  2.         
.         //manage pre/post tax prefixes 
.         local pf "pos"
  3.         local pre_lab "`pre_lab'"
  4.         
.         //exceptions 
.         if inlist("`c'", "BRA", "CRI"){
  5.                 local pf "pre"
  6.                 local pre_lab "pretax"
  7.         } 
  8.         
.         forvalues  y = $first_y / $last_y {
  9. 
.                 //open file 
.                 qui clear
 10.                 qui cap use "intermediary_data/microdata/raw/`c'/`c'_`y'_r
> aw.dta", clear
 11.                 
.                 *Only run when data exists
.                 qui cap assert _N == 0
 12.                 if _rc != 0 {
 13.                 
.                         //report activity in log 
.                         di as text "01e - part 2: Equal-splitting in " _conti
> nue 
 14.                         di as result "`c' - `y' " _continue 
 15.                         di as text "at $S_TIME"
 16.                         
.                         * make sure variables do not exist already 
.                         foreach v in "totesb" "totesn" {
 17.                                 cap drop `pf'_`v'_svy
 18.                         }
 19.                         
.                         * Equal-split incomes
.                         // narrow = among married couples, 
.                         // broad = among all adult persons in household
.                         qui gen spouse = (paren_ee <= 2)
 20.                         cap drop married 
 21.                         qui egen married = sum(spouse) if paren_ee <= 2, b
> y(id_hogar)
 22.                         qui egen double `pf'_totesn_svy = sum(`pf'_tot_svy
> /married) ///
>                                 if married<=2, by(id_hogar)
 23.                         qui replace `pf'_totesn_svy = `pf'_tot_svy if marr
> ied == .
 24.                         qui la var `pf'_totesn_svy ///
>                                 "Total equal-split (narrow) income `endlab'"
 25.                         qui egen `pf'_totesb_svy = ///
>                                 sum(`pf'_tot_svy / adults_house), by(id_hogar
> )
 26.                         qui la var `pf'_totesb_svy ///
>                                 "Total equal-split (broad) income `endlab'"
 27.                         
.                         //Get annualization factors for Argentina
.                         preserve 
 28.                                 qui import excel "input_data/prices_CEPAL/
> cpi_arg.xlsx", ///
>                                         sheet("datos") firstrow clear   
 29.                                 qui rename (Años__ESTANDAR Meses País__EST
> ANDAR) ///
>                                         (year month country) 
 30.                                 qui keep year month country value
 31.                                 qui destring year, replace 
 32.                                 qui gen m = 1 if month == "Enero"
 33.                                 qui replace m = 2 if month == "Febrero"
 34.                                 qui replace m = 3 if month == "Marzo"
 35.                                 qui replace m = 4 if month == "Abril"
 36.                                 qui replace m = 5 if month == "Mayo"
 37.                                 qui replace m = 6 if month == "Junio"
 38.                                 qui replace m = 7 if month == "Julio"
 39.                                 qui replace m = 8 if month == "Agosto"
 40.                                 qui replace m = 9 if month == "Septiembre"
 41.                                 qui replace m = 10 if month == "Octubre"
 42.                                 qui replace m = 11 if month == "Noviembre"
 43.                                 qui replace m = 12 if month == "Diciembre"
 44.                                 
.                                 *compute monthly factor 
.                                 qui gen f_m = value if m == 11 
 45.                                 bysort year: ereplace f_m = mean(f_m)
 46.                                 qui replace f_m = value / f_m 
 47.                                 
.                                 *compute annual factor 
.                                 qui collapse (sum) factor = f_m, by(country y
> ear)
 48.                         
.                                 *qui destring factor, replace   
.                                 qui sum factor if country == "Argentina" & ye
> ar == `y'
 49.                                 local f_ARG_`y' = r(mean)       
 50.                         restore 
 51.                                 
.                         //Annualize income variables    
.                         foreach var in ///
>                                 "wag" "fwag" "prwag" "prfwag" "pen" "mix" "ca
> p" "oth" ///
>                                 "ben" "imp" "kap" "mir" "tot" "totnb" "totesn
> " "totesb" {
 52.                                 if ("`c'" == "ARG" & `y' >= 2000) {
 53.                                         qui gen ind_`pf'_`var' = `pf'_`var
> '_svy * `f_ARG_`y''
 54.                                 } 
 55.                                 else {
 56.                                         cap drop ind_`pf'_`var' 
 57.                                         qui gen ind_`pf'_`var' = `pf'_`var
> '_svy * 12
 58.                                 }
 59.                         }
 60.                         
.                         //label income variables 
.                         local endlab "(survey) - annual `pre_lab'"
 61.                         qui la var ind_`pf'_wag "Wages `endlab2'"
 62.                         qui la var ind_`pf'_fwag "Formal wages `endlab2'"
 63.                         qui la var ind_`pf'_prwag "Private sector wages `e
> ndlab2'"
 64.                         qui la var ind_`pf'_prfwag "Private sect. formal w
> ages `endlab2'"
 65.                         qui la var ind_`pf'_pen "Pensions `endlab2'"
 66.                         qui la var ind_`pf'_mix "Mixed income `endlab2'"
 67.                         qui la var ind_`pf'_cap "Capital income `endlab2'"
 68.                         qui la var ind_`pf'_oth "Other transfers than pens
> ions `endlab2'"
 69.                         qui la var ind_`pf'_ben "Total Social benefits `en
> dlab2'"
 70.                         qui la var ind_`pf'_imp "Imputed rents `endlab2'"
 71.                         qui la var ind_`pf'_kap "Capital inc., w/ imputed 
> rents `endlab2'"
 72.                         qui la var ind_`pf'_mir "Mixed income & imputed re
> nts `endlab2'"
 73.                         qui la var ind_`pf'_tot "Total income `endlab2'"
 74.                         qui la var ind_`pf'_totnb "Total non-business inco
> me `endlab2'"
 75.                         qui la var ind_`pf'_totesn ///
>                                 "Total equal-split (narrow) inc. `endlab2'"
 76.                         qui la var ind_`pf'_totesb ///
>                                 "Total equal-split (broad) inc. `endlab2'"
 77.                         
.                         *Variables for comparison (CEPAL tot inc & WB/CEDLAS 
> series)
.                         cap drop percap_inc_cep
 78.                         cap confirm variable yto_he
 79.                         if _rc == 0 qui gen percap_inc_cep = (yto_he * 12)
>  / hh_size
 80.                         else {
 81.                                 qui gen percap_inc_cep =  (yto_pe * 12) / 
> hh_size  
 82.                                 else di as text "   * yto_he not found " _
> continue
 83.                                 di as text "using yto_pe instead"
 84.                         } 
 85.                         qui la var percap_inc_cep       "Per capita househ
> old income `pre_lab'"
 86.                         
.                         cap drop ind_`pf'_tot_imp
 87.                         qui gen ind_`pf'_tot_imp = ind_`pf'_tot + ind_`pf'
> _imp
 88.                         qui la var ind_`pf'_tot_imp "Total income w/ imp- 
> rents `endlab2'"
 89.                         
.                         *----------------------------------------------------
> ---------------
.                         *PART III: Impute missing incomes 
.                         *----------------------------------------------------
> ---------------
.                         
.                         *check if imputed rents is empty
.                         qui sum ind_`pf'_imp, meanonly 
 90.                         if "`macro_imp'" == "" {
 91.                                 *define reference income
.                                 local varli ""
 92.                                 foreach var in "wag" "pen" "cap" "mix" {
 93.                                         local varli "`varli' ind_`pf'_`var
> '"
 94.                                 }
 95.                                 tempvar aux1 
 96.                                 qui egen `aux1' = rowtotal(`varli')
 97.                                 *replace with 10% of it 
.                                 qui replace ind_`pf'_imp = 0.1 * `aux1'
 98.                         }
 99.                         
.                         *----------------------------------------------------
> ---------------
.                         *PART IV: Keep the necessary variables and save a dat
> a base:
.                         *----------------------------------------------------
> ---------------
. 
.                         *save important variables 
.                         if "`c'" == "BRA"  {
100.                                 qui keep condact3 sys_pe yjub_pe yoemp_pe 
> *_svy ind_* ///
>                                         _fep id_hogar id_pers paren_ee edad s
> exo adults_house ///
>                                         hh_size percap_inc_cep li lp pobreza 
> yto_pe ///
>                                         formal sector_ee categ5_p married ///
>                                         ramar_ee tamest_ee cotiza_ee //`pf'_s
> ys_13th `pf'_hol_svy  afilia_ee
101.                         }  
102.                         
.                         else if "`c'" == "DOM" & inrange(`y',2016,2020) {    
>                            
103.                                 qui keep yotrp_pe *_svy ind_* _fep id_hoga
> r id_pers ///
>                                         paren_ee married edad sexo adults_hou
> se ///
>                                         hh_size percap_inc_cep  li ///
>                                         lp pobreza yto_pe formal sector_ee ca
> teg5_p ///
>                                         ramar_ee tamest_ee
104.                         } 
105.                         
.                         else {                          
106.                                 qui keep *_svy ind_* _fep id_hogar id_pers
>  ///
>                                         paren_ee married edad sexo adults_hou
> se ///
>                                         hh_size percap_inc_cep  li ///
>                                         lp pobreza yto_pe formal sector_ee ca
> teg5_p ///
>                                         ramar_ee tamest_ee
107.                         } 
108.                 }
109.                 
.                 qui cap assert _N == 0
110.                 if _rc != 0 {
111.                         qui save ///
>                                 "intermediary_data/microdata/raw/`c'/`c'_`y'_
> raw.dta", replace
112.                                          
.                 }       
113.         }
114. }
