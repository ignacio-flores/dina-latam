. /*===========================================================================
> ==*
> Goal: Clean and prepare country surveys
> The do file's goal is to create the main income variables that are going
> to be used in the entire project (PART I-III). In PART IV, it creates differe
> nt 
> alternatives of proxies of capital ownership, in order to impute undistribute
> d 
> profits at a later stage.
> *============================================================================
> =*/
. 
. //General--------------------------------------------------------------------
> ---
.  
. clear all

. global aux_part  ""preliminary"" 

. qui do "code/Stata/auxiliar/aux_general.do"  

. 
. *which surveys do I clean?
. local countries "$all_countries"

. 
. * DINA_SURVEY_REVIEW_INPUTS: _fep edad id_hogar id_pers sexo sys_pe yoemp_pe 
> yjub_pe gan_pe ycap_pe yotr_pe yaim_he yto_pe yto_he categ5_p paren_ee sector
> _ee ramar_ee tamest_ee li lp pobreza
. 
. // Create directory if it doesnt exist
.         local dirpath "intermediary_data/microdata/raw"

.         mata: st_numscalar("exists", direxists(st_local("dirpath")))

.         if (scalar(exists) == 0) {
.                 mkdir "`dirpath'"
.                 display "Created directory: `dirpath'"
.         }

.  
.  
. //loop over countries and years 
. foreach c in `countries' {  
  2.         
.         //manage pre/post tax prefixes 
.         local pf "pos"
  3.         local pre_lab "`pre_lab'"
  4.         
.         //exceptions 
.         if inlist("`c'", "BRA", "CRI"){
  5.                 local pf "pre"
  6.                 local pre_lab "pretax"
  7.         } 
  8.         
.         forvalues  y = $first_y / $last_y {
  9. 
.                 //open file 
.                 qui clear
 10.                 qui cap use "input_data/surveys_CEPAL/`c'/`c'_`y'N.dta", c
> lear
 11.                 
.                 *Only run when data exists
.                 qui cap assert _N == 0
 12.                 if _rc != 0 {
 13.                 
.                         //report activity in log 
.                         di as text "01e - part 1: Cleaning survey in " _conti
> nue 
 14.                         di as result "`c' - `y' " _continue 
 15.                         di as text "at $S_TIME"
 16. 
.                         *----------------------------------------------------
> ---------------
.                         *PART 0: preliminary
.                         *----------------------------------------------------
> ---------------
. 
.                         //
.                         cap qui replace _fep = round(_fep) 
 17.                         * Calculating household size
.                         qui gen mem = 1
 18.                         qui egen hh_size = sum(mem), by(id_hogar)
 19.                         *tag adults / number of adults in the household
.                         qui gen  adults = 0
 20.                         qui replace adults = 1 if edad > 19
 21.                         qui egen adults_house = sum(adults), by(id_hogar) 
> // nº of adults
 22.                         *Social benefits (other than pensions)
.                         *qui gen y_sbe  = yoemp4
. 
.                         *----------------------------------------------------
> ---------------
.                         *PART I: create income variables
.                         *----------------------------------------------------
> ---------------
.                 
.                         *put 0 where null 
.                         mvencode sys_pe yoemp_pe yjub_pe gan_pe ycap_pe yotr_
> pe ///
>                                 yaim_he yto_pe yto_he, mv(0) override 
 23. 
.                         * Ia: income variables 
.                         qui gen `pf'_wag_svy = sys_pe + yoemp_pe        
 24.                         qui gen `pf'_pen_svy = yjub_pe // + yoemp4
 25.                         qui gen `pf'_mix_svy = gan_pe
 26.                         qui gen `pf'_bus_svy  = gan_pe if categ5_p==1 
 27.                         qui replace `pf'_bus_svy = 0 if `pf'_bus_svy==.
 28.                         qui gen `pf'_cap_svy = ycap_pe
 29.                         qui gen `pf'_oth_svy = yotr_pe
 30.                         qui gen `pf'_ben_svy = `pf'_pen_svy + `pf'_oth_svy
 31.                         qui gen `pf'_imp_svy = yaim_he / adults_house
 32.                         qui replace `pf'_imp_svy = 0 if edad < 20
 33.                         qui gen `pf'_kap_svy = `pf'_cap_svy + `pf'_imp_svy
 34.                         qui gen `pf'_mir_svy = `pf'_mix_svy + `pf'_imp_svy
 35.                         qui gen `pf'_tot_svy =  `pf'_wag_svy + `pf'_pen_sv
> y + ///
>                                 `pf'_mix_svy + `pf'_cap_svy + `pf'_oth_svy 
 36.                         qui gen `pf'_totnb_svy  = `pf'_tot_svy - `pf'_bus_
> svy
 37.                         
.                         if "`c'" == "BRA" {
 38.                                 qui gen `pf'_otn_svy = yotn_pe
 39.                                 qui replace `pf'_tot_svy = `pf'_tot_svy + 
> `pf'_otn_svy
 40.                         }
 41.                         
.                         * Ib: formal wages
.                         
.                         //define cases without formality info 
.                         if      ("`c'" == "BRA" & `y' == 1990) ///
>                                 | ("`c'" == "ARG" & inrange(`y', 2000, 2002))
>  ///
>                                 | ("`c'" == "BOL" & inrange(`y', 2014, 2015))
>  ///
>                                 | ("`c'" == "SLV" & inrange(`y', 2000, 2001))
>  ///
>                                 | ("`c'" == "CRI" & inrange(`y', 2000, 2001))
>  ///
>                                 | ("`c'" == "URY" & `y' == 2000) ///
>                                 /*| ("`c'" == "MEX" & `y' == 2000)*/ {
 42.                                 qui cap gen formal = 0
 43.                         }
 44.                         
.                         //define formality 
.                         else {
 45.                                 qui cap gen formal = 0
 46.                                 qui cap replace formal = 1 ///
>                                         if (cotiza_ee==1 | afilia_ee==1) & `p
> f'_wag_svy > 0
 47.                         }
 48.                         
.                         //formal wages and formal private sector 
.                         qui gen `pf'_fwag_svy = 0
 49.                         qui gen `pf'_prfwag_svy = 0 
 50.                         qui gen `pf'_prwag_svy = 0 
 51.                         qui replace `pf'_fwag_svy = `pf'_wag_svy if formal
>  == 1
 52.                         qui replace `pf'_prwag_svy = `pf'_wag_svy if secto
> r_ee == 2
 53.                         qui replace `pf'_prfwag_svy = `pf'_fwag_svy if sec
> tor_ee==2
 54.                         
.                         *Ic: income labels
.                         local endlab "(survey) - `pre_lab'"
 55.                         qui la var `pf'_wag_svy "Wages"
 56.                         qui la var `pf'_fwag_svy "Formal wages `endlab'"
 57.                         qui la var `pf'_prwag_svy "Wages from private sect
> or `endlab'"
 58.                         qui la var `pf'_prfwag_svy "Private sector formal 
> wages `endlab'"
 59.                         qui la var `pf'_pen_svy "Pensions `endlab'"
 60.                         qui la var `pf'_mix_svy "Mixed income `endlab'"
 61.                         qui la var `pf'_cap_svy "Capital income `endlab'"
 62.                         qui la var `pf'_oth_svy "Other transfer incomes th
> an pensions `endlab'"
 63.                         qui la var `pf'_ben_svy "Total Social benefits `en
> dlab'"
 64.                         qui la var `pf'_imp_svy "Imputed rents `endlab'"
 65.                         qui la var `pf'_kap_svy "All capital & mixed incom
> e `endlab'"
 66.                         qui la var `pf'_mir_svy "Mixed income plus imputed
>  rents `endlab'"
 67.                         qui la var `pf'_tot_svy "Total income `endlab'"
 68.                         qui la var `pf'_totnb_svy "Total non-business inco
> me `endlab'"
 69.                         
.                         *check for extreme values 
.                         if "`c'" == "ARG" local extreme = 500 
 70.                         if "`c'" != "ARG" local extreme = 1000
 71.                         
.                         qui sum `pf'_tot_svy [w=_fep], meanonly 
 72.                         local ai = r(mean) 
 73.                         qui gen excluder = `pf'_tot_svy / `ai'
 74.                         qui count if excluder >= `extreme'
 75.                         local ctr = r(N)
 76.                         
.                         /*
>                         di "average income: `ai'" 
>                         sum excluder, d
>                         qui sum _fep, meanonly 
>                         local aw = r(mean) 
>                         qui gen excluder2 = _fep / `aw' 
>                         di "average weight: `aw'"
>                         sum excluder2, d
>                         exit 1
>                         */
.                         if `ctr' > 0 {
 77.                                 di as text "extreme values: " _continue
 78.                                 di as result `ctr'
 79.                                 list id* edad categ5_p excluder if exclude
> r >= `extreme'
 80.                                 qui drop if excluder >= `extreme'       
 81.                         }
 82.                         cap drop excluder 
 83.                 }
 84.                 
.                 // Create directory if it doesnt exist 
.                 local dirpath "intermediary_data/microdata/raw/`c'"
 85.                 mata: st_numscalar("exists", direxists(st_local("dirpath")
> ))
 86.                 if (scalar(exists) == 0) {
 87.                         mkdir "`dirpath'"
 88.                         display "Created directory: `dirpath'"
 89.                 }
 90.                 
.                 // Save microdata 
.                 qui cap assert _N == 0
 91.                 if _rc != 0 {           
 92.                         qui save ///
>                                 "intermediary_data/microdata/raw/`c'/`c'_`y'_
> raw.dta", replace
 93.                 }       
 94.         }
 95. }
