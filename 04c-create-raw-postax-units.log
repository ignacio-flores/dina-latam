. do code/Stata/04c-create-raw-postax-units.do 

. /////////////////////////////////////////////////////////////////////////////
> ///
> //
. //                                                      Title:  
. //                       Authors: Mauricio DE ROSA, Ignacio FLORES, Marc MORG
> AN 
. //                                                                      Year:
>  2020
. //
. /////////////////////////////////////////////////////////////////////////////
> ///
> 
. clear all

. 
. //0. General settings -------------------------------------------------------
> ---
. 
. //define macros 
. if "${bfm_replace}" == "yes" local ext ""

. if "${bfm_replace}" == "no" local ext "_norep"

. 
. //get list of paths 
. global aux_part " "preliminary" " 

. qui do "code/Stata/auxiliar/aux_general.do"

. local lang $lang 

. 
. global area " ${all_countries} "

. local z = 1 

. foreach c in $area {
  2.         forvalues y = ${first_y}/${last_y} {
  3.                 clear 
  4.                 
.                 if `z' == 1 {
  5.                         di as result "{hline 80}"
  6.                         display as result ///
>                                 "Creating raw post-tax variables for units ..
> ."
  7.                         di as result "{hline 80}"
  8.                         local z = 0 
  9.                 }       
 10.                         
.                 *inform activity
.                 di as text "`c' `y': " _continue
 11.                 
.                 //confirm corrected survey exists 
.                 capture confirm file ///
>                         "intermediary_data/microdata/bfm`ext'_pre/`c'_`y'_bfm
> `ext'_pre.dta"
 12.                 
.                 //open it
.                 if _rc==0 {
 13.                         qui use ///
>                                 "intermediary_data/microdata/bfm`ext'_pre/`c'
> _`y'_bfm`ext'_pre.dta", clear
 14.                         
.                         cap drop __*
 15.                         
.                         *loop over income items 
.                         foreach v in wag pen cap imp mix {
 16.                                 
.                                 *compute sum of incomes by couple (narrow)
.                                 cap drop esn_pos_`v'
 17.                                 qui egen esn_pos_`v' = sum(ind_pos_`v'/mar
> ried) ///
>                                         if married <= 2, by(id_hogar)
 18.                                 qui replace esn_pos_`v' = ///
>                                         ind_pos_`v' if missing(married)
 19.                                 qui cap la var esn_pos_`v' ///
>                                         "Eq-split narrow posttax inc. `v'"   
>    
 20.                                         
.                                 *compute sum of incomes by adults (broad)
.                                 cap drop esb_pos_`v'
 21.                                 qui egen esb_pos_`v' = ///
>                                         sum(ind_pos_`v'/adults_house), by(id_
> hogar)
 22.                                 qui la var esb_pos_`v' ///
>                                         "Eq-split broad `posttax inc. `v'"   
>    
 23.                                 
.                                 *compute sum of incomes by household 
.                                 cap drop pch_pos_`v'
 24.                                 qui egen pch_pos_`v' = ///
>                                         sum(ind_pos_`v' / hh_size), by(id_hog
> ar)
 25.                                 qui la var pch_pos_`v' ///
>                                         "Per capita hld. posttax inc. `v'"
 26.                         }
 27.                         
.                         *save 
.                         qui save ///
>                                 "intermediary_data/microdata/bfm`ext'_pre/`c'
> _`y'_bfm`ext'_pre.dta" ///
>                                 , replace
 28.                         
.                         *report activity        
.                         di as result "done"     
 29.                 }
 30.                 else {
 31.                         di as text "intermediary_data/microdata/bfm`ext'_p
> re/`c'_`y'_bfm`ext'_pre.dta not found."
 32.                 }
 33.         }
 34. }       
